# Copy this file to backend/.env and fill it in. backend/.env is git-ignored.

# Postgres connection: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://canteen:changeme@localhost:5432/canteen

# True for local development only. When False, SECRET_KEY below is required.
DEBUG=True

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Comma-separated hostnames/IPs allowed to reach Django.
# Add this machine's LAN IP (e.g. 192.168.1.33) so phones and kitchen screens can connect.
ALLOWED_HOSTS=localhost,127.0.0.1

# Only needed if the frontend is served from a different origin than Django.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Email ──────────────────────────────────────────────────────────────────
# Students get "order placed" and "ready to collect" emails at the
# address they signed up with. Leave EMAIL_HOST empty and emails are printed in
# the Django terminal instead (nothing breaks).
#
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste its 16 letters below.
# (Your normal Gmail password will NOT work.) Gmail allows ~500 emails/day.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=yourcanteen@gmail.com
EMAIL_HOST_PASSWORD=
# Optional; defaults to EMAIL_HOST_USER. Gmail only sends from your own address.
# DEFAULT_FROM_EMAIL=Campus Canteen <yourcanteen@gmail.com>

# Where low-stock alerts and the daily sales report are emailed.
MANAGER_EMAIL=manager@college.edu

# FTP server for manager menu uploads (python manage.py run_ftp_server)
FTP_MANAGER_USER=manager
FTP_MANAGER_PASSWORD=

# Backup FTP target for daily sales CSVs (python manage.py backup_sales)
BACKUP_FTP_HOST=127.0.0.1
BACKUP_FTP_PORT=2122
BACKUP_FTP_USER=manager
BACKUP_FTP_PASSWORD=
BACKUP_FTP_DIR=/
